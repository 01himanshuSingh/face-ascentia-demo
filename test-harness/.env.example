# Default: Vite proxies /api → http://localhost:8000 (localhost + ngrok harness).
VITE_API_BASE_URL=/api

# Direct backend URL (optional — Mendix-style, no Vite proxy):
# VITE_API_BASE_URL=http://localhost:8000

# Remote phone without Vite proxy: tunnel backend and set full HTTPS origin:
# VITE_API_BASE_URL=https://your-backend.ngrok-free.dev
